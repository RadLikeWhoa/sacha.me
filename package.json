{
  "name": "radlikewhoa-github-io",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier . -c --write",
    "format:check": "prettier . -l",
    "lint:ts": "eslint src/**/*.{ts,astro}",
    "lint:ts:fix": "pnpm lint:ts -- --fix",
    "lint:css": "stylelint src/**/*.{css,astro}",
    "lint:css:fix": "pnpm lint:css -- --fix",
    "lint": "pnpm lint:ts && pnpm lint:css",
    "lint:fix": "pnpm lint:ts:fix && pnpm lint:css:fix",
    "typecheck": "astro check",
    "test:e2e": "pnpm exec playwright test"
  },
  "dependencies": {
    "@astrojs/rss": "~4.0.19",
    "@astrojs/sitemap": "~3.7.3",
    "astro": "~7.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "~0.9.10",
    "@eslint/js": "~10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "eslint": "~10.8.0",
    "eslint-plugin-astro": "~3.1.0",
    "postcss-html": "~2.0.0",
    "prettier": "~3.9.6",
    "prettier-plugin-astro": "~0.14.1",
    "sharp": "~0.35.3",
    "stylelint": "~17.14.1",
    "stylelint-config-html": "~2.0.0",
    "stylelint-config-property-sort-order-smacss": "~11.2.0",
    "stylelint-config-recommended": "~18.0.0",
    "stylelint-order": "~8.1.1",
    "stylelint-use-logical": "~2.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.66.0"
  }
}
