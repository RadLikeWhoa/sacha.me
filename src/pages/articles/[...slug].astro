---
import ContactTeaser from '@/components/ui/ContactTeaser/ContactTeaser.astro';
import Layout from '@/layouts/Layout.astro';
import { type CollectionEntry, getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');

  return articles.map((article) => ({
    params: { slug: article.id },
    props: article,
  }));
}

type Props = CollectionEntry<'articles'>;

const article = Astro.props;
const { title, date, teaser } = article.data;
const { Content } = await render(article);
---

<Layout seo={{ title, description: teaser, pubDate: date, type: 'article' }}>
  <article>
    <header>
      <h1>{title}</h1>
      <time>
        {
          date.toLocaleDateString('en-UK', {
            year: 'numeric',
            month: 'long',
            day: '2-digit',
          })
        }
      </time>
    </header>
    <div class="content">
      <Content />
    </div>
    <ContactTeaser
      cta="Read more articles"
      target="/articles/"
    />
  </article>
</Layout>

<style>
  article {
    padding-block: 3rem;

    @container main (inline-size >= 45rem) {
      padding-block: 4.5rem;
    }
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-block-end: 3rem;
  }

  time {
    color: var(--text-color-muted);
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-block-end: 1.5rem;

    :global(.astro-code) {
      padding: 1.5rem;
      border-radius: var(--border-radius);
    }

    :global(:is(h1, h2, h3)) {
      margin-block-start: 1.5rem;
    }
  }
</style>
