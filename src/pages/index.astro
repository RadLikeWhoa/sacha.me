---
import ArticleTeaser from '@/components/article/ArticleTeaser/ArticleTeaser.astro';
import IconWell from '@/components/project/IconWell/IconWell.astro';
import Button from '@/components/ui/Button/Button.astro';
import Container from '@/components/ui/Container/Container.astro';
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const article = (await getCollection('articles'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .at(0);
---

<Layout>
  <Container>
    <section class="section-intro">
      <p>
        Hi there, my name is <b>Sacha</b> and I am a front-end developer and designer.
        I design and build websites and applications using modern technologies and
        methodologies.
      </p>
    </section>
    <section class="section-projects">
      <div class="projects">
        <ol class="projects-list">
          {
            projects.map((project) => (
              <li>
                <IconWell
                  project={project}
                  elevation="high"
                />
              </li>
            ))
          }
        </ol>
        <p>
          This is a selection of some of my latest projects. You can read a
          detailed case study on all of them or you can check out a list of all
          my past and current projects.
        </p>
        <Button
          href="/projects"
          elevation="high"
        >
          Discover more projects
        </Button>
      </div>
    </section>
    {
      article && (
        <section class="section-articles">
          <h1 class="section-title">Latest article</h1>
          <ArticleTeaser article={article} />
          <Button href="/articles">Read more articles</Button>
        </section>
      )
    }
  </Container>
</Layout>

<style>
  .section-intro,
  .section-articles {
    padding-block: 4.5rem;
  }

  .section-intro {
    > p {
      font-size: 1.3rem;
      line-height: 1.54;
    }
  }

  .section-articles {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;

    > h1 {
      inline-size: 100%;
      border-block-end: 5px solid;
      padding-block-end: 0.5rem;
    }
  }

  .projects {
    container: projects / inline-size;
    display: flex;
    position: relative;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding-inline: 1.5rem;

    > p {
      text-align: center;
    }

    &::before {
      content: '';
      position: absolute;
      z-index: -1;
      border-radius: var(--border-radius);
      background-color: #fdf9f2;
      inset: 3rem 0 1.5rem;
      box-shadow: var(--shadow-elevation-low);
    }
  }

  .projects-list {
    display: grid;
    grid-template-columns: 1fr;
    inline-size: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    gap: 1.5rem;

    @container projects (min-inline-size: 30rem) {
      grid-template-columns: repeat(3, minmax(0, 1fr));

      li:first-child .icon-well {
        rotate: -1deg;
      }

      li:last-child .icon-well {
        rotate: 1deg;
      }
    }
  }
</style>
