---
import ArticleTeaser from '@/components/ArticleTeaser.astro';
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';

const article = (await getCollection('articles'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .at(0);
---

<Layout>
  <section>
    <p>
      Hi there, my name is <b>Sacha</b> and I am a front-end developer and designer.
      I design and build websites and applications using modern technologies and methodologies.
    </p>
  </section>
  <!-- Projects -->
  {
    article && (
      <section>
        <h1>Latest article</h1>
        <ArticleTeaser article={article} />
        <a
          href="/articles"
          data-astro-prefetch
        >
          Read more articles
        </a>
      </section>
    )
  }
</Layout>
