---
import ArticleTeaser from '@/components/article/ArticleTeaser/ArticleTeaser.astro';
import IconWell from '@/components/project/IconWell/IconWell.astro';
import Button from '@/components/ui/Button/Button.astro';
import Container from '@/components/ui/Container/Container.astro';
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const article = (await getCollection('articles'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .at(0);
---

<Layout>
  <Container>
    <h1 class="visually-hidden">Sacha Schmid — Front-end developer</h1>
    <section class="section-intro">
      <p>
        I'm <b>Sacha</b>, a front-end developer and designer. I build websites
        and applications using modern technologies and methodologies.
      </p>
    </section>
    <section class="section-projects">
      <div class="projects">
        <ol class="projects-list">
          {
            projects.map((project) => (
              <li>
                <IconWell
                  elevation="high"
                  project={project}
                />
              </li>
            ))
          }
        </ol>
        <p>
          This is a selection of my most recent projects. Detailed case studies
          are available for each, or you can view a complete list of my past and
          current work.
        </p>
        <Button
          elevation="high"
          href="/projects/"
        >
          Discover more projects
        </Button>
      </div>
    </section>
    {
      article && (
        <section class="section-articles">
          <h2 class="section-title">Latest article</h2>
          <ArticleTeaser
            article={article}
            level="h3"
          />
          <Button href="/articles/">Read more articles</Button>
        </section>
      )
    }
  </Container>
</Layout>

<style>
  .section-intro,
  .section-articles {
    padding-block: 3rem;

    @container main (inline-size >= 45rem) {
      padding-block: 4.5rem;
    }
  }

  .section-intro {
    > p {
      font-size: 1.3rem;
      line-height: 1.54;
    }
  }

  .section-articles {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;

    > h2 {
      inline-size: 100%;
      border-block-end: 5px solid;
      padding-block-end: 0.5rem;
    }
  }

  .section-projects {
    container: teaser / inline-size;
  }

  .projects {
    display: flex;
    position: relative;
    flex-direction: column;
    gap: 1.5rem;
    padding-inline: 1.5rem;

    &::before {
      content: '';
      position: absolute;
      z-index: -1;
      border-radius: var(--border-radius);
      background-color: var(--widget-color);
      inset: 3rem 0 1.5rem;
      box-shadow: var(--shadow-elevation-low);
    }

    @container teaser (inline-size >= 30rem) {
      align-items: center;
      text-align: center;
    }
  }

  .projects-list {
    display: grid;
    grid-template-columns: 1fr;
    inline-size: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    gap: 1.5rem;

    @container teaser (inline-size >= 30rem) {
      grid-template-columns: repeat(3, minmax(0, 1fr));

      li:first-child .icon-well {
        rotate: -1deg;
      }

      li:last-child .icon-well {
        rotate: 1deg;
      }
    }
  }
</style>
