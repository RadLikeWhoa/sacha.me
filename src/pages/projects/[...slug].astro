---
import ContactTeaser from '@/components/ContactTeaser.astro';
import Layout from '@/layouts/Layout.astro';
import { Image } from 'astro:assets';
import { type CollectionEntry, getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects.map((project) => ({
    params: { slug: project.id },
    props: project,
  }));
}

type Props = CollectionEntry<'projects'>;

const project = Astro.props;
const { Content } = await render(project);

const {
  date,
  title,
  teaser,
  repo,
  link,
  hero,
  tags,
  tasks,
  technologies,
  end,
  accent,
} = project.data;
---

<Layout
  title={title}
  accent={accent}
  headerBackgroundColor={accent}
  headerForegroundColor="#fdf9f2"
>
  <article>
    <header>
      <div class="header-content">
        <h1>{title}</h1>
        <p>{teaser}</p>
      </div>
    </header>
    <div class="hero-image">
      {
        link ? (
          <a
            href={link}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Image
              src={hero}
              alt={title}
              loading="eager"
            />
          </a>
        ) : (
          <Image
            src={hero}
            alt={title}
          />
        )
      }
    </div>
    <div class="content">
      <dl>
        <dt>Started</dt>
        <dd>{date.toLocaleDateString('de-CH', { year: 'numeric' })}</dd>
        {
          end && (
            <>
              <dt>Ended</dt>
              <dd>{end}</dd>
            </>
          )
        }
        {
          repo && (
            <>
              <dt>Repository</dt>
              <dd>
                <a
                  href={repo}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {repo}
                </a>
              </dd>
            </>
          )
        }
        {
          link && (
            <>
              <dt>URL</dt>
              <dd>
                <a
                  href={link}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {link}
                </a>
              </dd>
            </>
          )
        }
        <dt>Tags</dt>
        <dd>{tags.join(', ')}</dd>
      </dl>
      <Content />
      <dl>
        <dt>Tasks</dt>
        <dd>{tasks.join(', ')}</dd>
        <dt>Technologies</dt>
        <dd>{technologies.join(', ')}</dd>
      </dl>
      <ContactTeaser
        cta="Discover more projects"
        target="/projects"
      />
    </div>
  </article>
</Layout>

<style>
  .content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-inline-size: var(--content-width);
    margin-inline: auto;
    padding-block: 4.5rem;

    :global(p > img) {
      display: block;
      block-size: auto;
      inline-size: 100%;
      border-radius: 10px;
      box-shadow: var(--shadow-elevation-low);
    }

    :global(:is(h1, h2, h3)) {
      margin-block-start: 1.5rem;
    }
  }

  header {
    display: flex;
    flex-direction: column;
    padding-block: 4.5rem;
    background-color: var(--header-background-color);
    gap: 0.5rem;
    color: #faf0e1;

    h1 {
      padding-block-end: 0.5rem;
      font-size: 4rem;
      line-height: 1.125;
      border-block-end: 5px solid;
      overflow-wrap: anywhere;
    }

    p {
      font-size: 1.3em;
      line-height: 1.54;
    }
  }

  .header-content {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    max-inline-size: var(--content-width);
    margin-inline: auto;
  }

  .hero-image {
    position: relative;

    a {
      display: block;
      inline-size: fit-content;
      margin-inline: auto;
      text-decoration: none;
    }

    img {
      display: block;
      block-size: auto;
      max-inline-size: var(--content-width);
      margin-inline: auto;
      border: 5px solid #fff;
      border-radius: 10px;
      box-shadow: var(--shadow-elevation-high);
    }

    &::before {
      content: '';
      position: absolute;
      z-index: -1;
      block-size: 4.5rem;
      background-color: var(--header-background-color);
      inset-block-start: 0;
      inset-inline: 0;
      box-shadow: var(--shadow-elevation-low);
    }
  }
</style>
