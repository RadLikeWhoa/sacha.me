---
import ContactTeaser from '@/components/ui/ContactTeaser/ContactTeaser.astro';
import Container from '@/components/ui/Container/Container.astro';
import Layout from '@/layouts/Layout.astro';
import { Image } from 'astro:assets';
import { type CollectionEntry, getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects.map((project) => ({
    params: { slug: project.id },
    props: project,
  }));
}

type Props = CollectionEntry<'projects'>;

const project = Astro.props;
const { Content } = await render(project);

const {
  date,
  title,
  teaser,
  repo,
  link,
  hero,
  tags,
  tasks,
  technologies,
  accent,
} = project.data;
---

<Layout
  seo={{ title, description: teaser, pubDate: date, type: 'project' }}
  accent={accent}
  headerBackgroundColor={accent}
  headerForegroundColor="var(--background-color)"
>
  <article>
    <header>
      <Container>
        <div class="header-content">
          <h1>{title}</h1>
          <p>{teaser}</p>
        </div>
      </Container>
    </header>
    <div class="hero-image">
      <Container>
        {
          link ? (
            <a
              href={link}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Image
                src={hero}
                alt={title}
                loading="eager"
              />
            </a>
          ) : (
            <Image
              src={hero}
              alt={title}
            />
          )
        }
      </Container>
    </div>
    <Container>
      <div class="content">
        <dl>
          <dt>Year</dt>
          <dd>{date.toLocaleDateString('de-CH', { year: 'numeric' })}</dd>
          {
            repo && (
              <>
                <dt>Repository</dt>
                <dd>
                  <a
                    href={repo}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {repo}
                  </a>
                </dd>
              </>
            )
          }
          {
            link && (
              <>
                <dt>URL</dt>
                <dd>
                  <a
                    href={link}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {link}
                  </a>
                </dd>
              </>
            )
          }
          <dt>Tags</dt>
          <dd>{tags.join(', ')}</dd>
        </dl>
        <Content />
        <dl>
          <dt>Tasks</dt>
          <dd>{tasks.join(', ')}</dd>
          <dt>Technologies</dt>
          <dd>{technologies.join(', ')}</dd>
        </dl>
        <ContactTeaser
          cta="Discover more projects"
          target="/projects"
        />
      </div>
    </Container>
  </article>
</Layout>

<style>
  .content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-block: 4.5rem;

    :global(p > img) {
      display: block;
      block-size: auto;
      inline-size: 100%;
      border-radius: var(--border-radius);
      box-shadow: var(--shadow-elevation-low);
    }

    :global(:is(h1, h2, h3)) {
      margin-block-start: 1.5rem;
    }
  }

  header {
    display: flex;
    flex-direction: column;
    padding-block: 4.5rem;
    background-color: var(--header-background-color);
    gap: 0.5rem;
    color: var(--header-foreground-color);

    h1 {
      padding-block-end: 0.5rem;
      font-size: 4rem;
      line-height: 1.125;
      border-block-end: 5px solid;
      overflow-wrap: anywhere;
    }

    p {
      font-size: 1.3em;
      line-height: 1.54;
    }
  }

  .header-content {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .hero-image {
    position: relative;

    a {
      display: block;
      inline-size: fit-content;
      margin-inline: auto;
      text-decoration: none;
    }

    img {
      display: block;
      block-size: auto;
      inline-size: 100%;
      border: 5px solid var(--widget-color);
      border-radius: var(--border-radius);
      box-shadow: var(--shadow-elevation-high);
    }

    &::before {
      content: '';
      position: absolute;
      z-index: -1;
      block-size: 4.5rem;
      background-color: var(--header-background-color);
      inset-block-start: 0;
      inset-inline: 0;
      box-shadow: var(--shadow-elevation-low);
    }
  }
</style>
