---
import type { CollectionEntry } from 'astro:content';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;

const {
  id,
  data: { title, teaser },
} = article;
---

<article>
  <h1>
    <a
      href={`/articles/${id}`}
      data-astro-prefetch
    >
      {title}
    </a>
  </h1>
  <p>{teaser}</p>
</article>

<style>
  article {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  h1,
  p {
    margin-block-end: 0;
  }
</style>
