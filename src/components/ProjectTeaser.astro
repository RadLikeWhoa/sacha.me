---
import type { CollectionEntry } from 'astro:content';
import IconWell from './IconWell.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  alternate: boolean;
}

const { project, alternate } = Astro.props;

const {
  id,
  data: { title, teaser, tags, date },
} = project;
---

<article class:list={[{ alternate }]}>
  <IconWell project={project} />
  <h1>
    <a
      href={`/projects/${id}`}
      data-astro-prefetch
    >
      {title}
    </a>
  </h1>
  <p>
    <time>{date.toLocaleDateString('en-UK', { year: 'numeric' })}</time> – {
      teaser
    }
  </p>
  <ul>
    {tags.map((tag) => <li>{tag}</li>)}
  </ul>
  <a href={`/projects/${project.id}`}>Read more</a>
</article>

<style>
  article {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;

    > :is(h1, p) {
      margin-block-end: 0;
    }
  }

  time {
    color: #aaa;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
    gap: 0.5rem;
  }

  li {
    padding: 0.25rem 0.75rem;
    border-radius: 10px;
    background-color: #aaa;
  }
</style>
