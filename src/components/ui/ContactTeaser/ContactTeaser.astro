---
import Button from '../Button/Button.astro';

interface Props {
  cta: string;
  target: string;
}

const { cta, target } = Astro.props;
---

<section>
  <div class="teaser">
    <p>
      For comments and questions, <a href="mailto:hello@sacha.me">
        contact me through e-mail
      </a>.
    </p>
    <Button
      href={target}
      raised
      suffix="keyboard_double_arrow_right"
    >
      {cta}
    </Button>
  </div>
</section>

<style>
  section {
    position: relative;
    inline-size: 100%;
    max-inline-size: var(--content-width);
    margin-inline: auto;
    padding: 1.5rem 1.5rem 0;

    &::before {
      content: '';
      position: absolute;
      z-index: -1;
      border-radius: 10px;
      background-color: #fdf9f2;
      inset: 0 0 1.5rem;
      box-shadow: var(--shadow-elevation-low);
    }
  }

  .teaser {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;

    > p {
      margin-block-end: 0;
      text-align: center;
    }
  }
</style>
