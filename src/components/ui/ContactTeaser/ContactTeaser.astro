---
import Button from '../Button/Button.astro';

interface Props {
  cta: string;
  target: string;
}

const { cta, target } = Astro.props;
---

<section>
  <div class="teaser">
    <p>
      For comments and questions, <a href="mailto:hello@sacha.me">
        contact me through e-mail
      </a>.
    </p>
    <Button
      elevation="high"
      href={target}
    >
      {cta}
    </Button>
  </div>
</section>

<style>
  section {
    position: relative;
    padding: 1.5rem 1.5rem 0;
    container: teaser / inline-size;

    &::before {
      content: '';
      position: absolute;
      z-index: -1;
      border-radius: var(--border-radius);
      background-color: var(--widget-color);
      inset: 0 0 1.5rem;
      box-shadow: var(--shadow-elevation-low);
    }
  }

  .teaser {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;

    @container teaser (inline-size >= 30rem) {
      align-items: center;
      text-align: center;
    }
  }
</style>
