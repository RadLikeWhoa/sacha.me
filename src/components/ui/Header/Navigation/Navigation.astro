---
import Link from './Link/Link.astro';
---

<button
  aria-controls="site-nav"
  aria-expanded="false"
  aria-label="Navigation"
  class="toggle"
  id="nav-toggle"
  type="button"
>
  <span
    aria-hidden="true"
    class="hamburger"
  ></span>
</button>
<nav id="site-nav">
  <ol>
    <li>
      <Link
        exact
        href="/"
      >
        Home
      </Link>
    </li>
    <li>
      <Link href="/projects/">Projects</Link>
    </li>
    <li>
      <Link href="/articles/">Articles</Link>
    </li>
    <li>
      <Link href="/about/">About</Link>
    </li>
  </ol>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle');

  toggle?.addEventListener('click', () => {
    toggle.setAttribute(
      'aria-expanded',
      String(!(toggle.getAttribute('aria-expanded') === 'true')),
    );
  });
</script>

<style>
  .hamburger {
    &,
    &::before,
    &::after {
      display: block;
      position: absolute;
      block-size: 2px;
      inline-size: 1.5rem;
      border-radius: 1px;
      background-color: currentColor;

      @media (prefers-reduced-motion: no-preference) {
        transition:
          translate 0.25s ease-in-out,
          rotate 0.25s ease-in-out,
          background-color 0.25s ease-in-out;
      }
    }

    &::before,
    &::after {
      content: '';
    }

    &::before {
      translate: 0 -0.5rem;
    }

    &::after {
      translate: 0 0.5rem;
    }
  }

  .toggle {
    display: inline-grid;
    position: relative;
    block-size: 3rem;
    inline-size: 3rem;
    margin-inline-start: auto;
    border: none;
    border-radius: var(--border-radius);
    background: none;
    color: var(--header-foreground-color);
    cursor: pointer;
    place-items: center;
    appearance: none;

    &[aria-expanded='true'] {
      .hamburger {
        background-color: transparent;

        &::before {
          translate: 0 0;
          rotate: 45deg;
        }

        &::after {
          translate: 0 0;
          rotate: -45deg;
        }
      }
    }

    @container header (inline-size >= 45rem) {
      display: none;
    }
  }

  nav {
    @container header (inline-size < 45rem) {
      grid-column: 1 / -1;

      .toggle[aria-expanded='false'] + & {
        display: none;
      }

      @starting-style {
        opacity: 0;
      }

      @media (prefers-reduced-motion: no-preference) {
        transition: opacity 0.25s ease-in-out;
      }
    }

    @container header (inline-size >= 45rem) {
      display: block;
      position: static;
      margin: 0;
      padding: 0;
      border: 0;
      background: none;
      inset: auto;
    }
  }

  ol {
    display: flex;
    position: relative;
    z-index: 1;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;

    &::before {
      content: '';
      display: block;
      position: absolute;
      z-index: 0;
      block-size: 3rem;
      inline-size: 100%;
      border-radius: var(--border-radius);
      background-color: var(--header-foreground-color);
      inset-block: 0;
      inset-inline-start: 0;
      box-shadow: var(--shadow-elevation-low);

      @container header (inline-size >= 45rem) {
        block-size: 100%;
        inline-size: 25%;
      }

      @media (prefers-reduced-motion: no-preference) {
        transition:
          translate 0.25s ease-in-out,
          background-color 0.25s ease-in-out,
          opacity 0.25s ease-in-out;
      }
    }

    &:not(:has(.active, :hover, :focus-visible))::before {
      opacity: 0;
    }

    &:has(a:is(:hover, :focus-visible)) {
      a {
        color: var(--header-foreground-color);

        &:is(:hover, :focus-visible) {
          color: var(--header-background-color);
        }
      }

      &::before {
        background-color: light-dark(
          hsl(from var(--header-foreground-color) h s calc(l - 10)),
          hsl(from var(--header-foreground-color) h s calc(l + 10))
        );
      }
    }

    /* stylelint-disable no-descending-specificity */
    &:has(li:nth-child(1) .active)::before,
    &:has(li:nth-child(1) a:is(:hover, :focus-visible))::before {
      translate: 0 0;
    }

    &:has(li:nth-child(2) .active)::before,
    &:has(li:nth-child(2) a:is(:hover, :focus-visible))::before {
      translate: 100% 0;

      @container header (inline-size < 45rem) {
        translate: 0 100%;
      }
    }

    &:has(li:nth-child(3) .active)::before,
    &:has(li:nth-child(3) a:is(:hover, :focus-visible))::before {
      translate: 200% 0;

      @container header (inline-size < 45rem) {
        translate: 0 200%;
      }
    }

    &:has(li:nth-child(4) .active)::before,
    &:has(li:nth-child(4) a:is(:hover, :focus-visible))::before {
      translate: 300% 0;

      @container header (inline-size < 45rem) {
        translate: 0 300%;
      }
    }
    /* stylelint-enable no-descending-specificity */

    @container header (inline-size >= 45rem) {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  li {
    position: relative;
    z-index: 1;
  }
</style>
