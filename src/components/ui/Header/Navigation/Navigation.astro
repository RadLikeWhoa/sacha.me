---
import Link from './Link/Link.astro';
---

<nav>
  <ol>
    <li>
      <Link
        href="/"
        exact
      >
        Home
      </Link>
    </li>
    <li>
      <Link href="/projects/">Projects</Link>
    </li>
    <li>
      <Link href="/articles/">Articles</Link>
    </li>
    <li>
      <Link href="/about/">About</Link>
    </li>
  </ol>
</nav>

<style>
  ol {
    display: grid;
    position: relative;
    z-index: 1;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;

    &::before {
      content: '';
      display: block;
      position: absolute;
      z-index: 0;
      block-size: 100%;
      inline-size: 25%;
      transition:
        translate 0.25s ease-in-out,
        background-color 0.25s ease-in-out;
      border-radius: var(--border-radius);
      background-color: var(--header-foreground-color);
      inset-block: 0;
      inset-inline-start: 0;
      box-shadow: var(--shadow-elevation-low);

      @media (prefers-reduced-motion: reduce) {
        transition: none;
      }
    }

    &:not(:has(.active))::before {
      background-color: transparent;
      box-shadow: none;
    }

    &:has(a:is(:hover, :focus-visible)) {
      a {
        color: var(--header-foreground-color);

        &:is(:hover, :focus-visible) {
          color: var(--header-background-color);
        }
      }

      &::before {
        background-color: light-dark(
          hsl(from var(--header-foreground-color) h s calc(l - 10)),
          hsl(from var(--header-foreground-color) h s calc(l + 10))
        );
      }
    }

    /* stylelint-disable no-descending-specificity */
    &:has(li:nth-child(1) .active)::before,
    &:has(li:nth-child(1) a:is(:hover, :focus-visible))::before {
      translate: 0 0;
    }

    &:has(li:nth-child(2) .active)::before,
    &:has(li:nth-child(2) a:is(:hover, :focus-visible))::before {
      translate: 100% 0;
    }

    &:has(li:nth-child(3) .active)::before,
    &:has(li:nth-child(3) a:is(:hover, :focus-visible))::before {
      translate: 200% 0;
    }

    &:has(li:nth-child(4) .active)::before,
    &:has(li:nth-child(4) a:is(:hover, :focus-visible))::before {
      translate: 300% 0;
    }
    /* stylelint-enable no-descending-specificity */
  }

  li {
    position: relative;
    z-index: 1;
  }
</style>
