---
import Logo from '@/assets/logo.svg';
import Container from '../Container/Container.astro';
import Navigation from './Navigation/Navigation.astro';
---

<header>
  <Container>
    <div class="content">
      <a
        href="/"
        data-astro-prefetch
      >
        <Logo />
      </a>
      <Navigation />
    </div>
  </Container>
</header>

<style>
  header {
    padding-block-start: 1.5rem;
    background-color: var(--header-background-color, transparent);
  }

  .content {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  a {
    display: inline-block;

    &:is(:hover, :focus-visible) {
      animation: boink 0.25s ease-in-out;
    }
  }

  svg {
    display: block;
    block-size: 3rem;
    inline-size: 3rem;
    will-change: transform;
  }

  @keyframes boink {
    50% {
      transform: rotateZ(-5deg);
    }
  }
</style>
