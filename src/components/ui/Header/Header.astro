---
import Logo from '@/assets/logo.svg';
import Navigation from './Navigation/Navigation.astro';
---

<header class="container">
  <div class="content">
    <a
      aria-label="Go to homepage"
      data-astro-prefetch
      href="/"
    >
      <Logo aria-hidden="true" />
    </a>
    <Navigation />
  </div>
</header>

<style>
  header {
    position: relative;
    container: header / inline-size;

    &::before {
      content: '';
      position: absolute;
      z-index: -1;
      inline-size: 100dvw;
      inset-inline-start: 50%;
      translate: -50dvw 0;
      inset-block: 0;
      background-color: var(--header-background-color);
    }
  }

  .content {
    display: grid;
    position: relative;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: 1.5rem 0;
    padding-block-start: 1.5rem;

    @container header (inline-size >= 45rem) {
      padding-block-start: 3rem;
    }
  }

  a {
    --logo-color: var(--header-foreground-color);

    display: inline-block;
    inline-size: fit-content;

    &:is(:hover, :focus-visible) {
      --logo-color: light-dark(
        hsl(from var(--header-foreground-color) h s calc(l - 10)),
        hsl(from var(--header-foreground-color) h s calc(l + 10))
      );

      @media (prefers-reduced-motion: no-preference) {
        animation: boink 0.25s ease-in-out;
      }
    }
  }

  svg {
    display: block;
    block-size: 3rem;
    inline-size: 3rem;
    will-change: transform;
  }

  @keyframes boink {
    50% {
      transform: rotateZ(-5deg);
    }
  }
</style>
