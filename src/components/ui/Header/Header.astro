---
import Logo from '@/assets/logo.svg';
import Container from '../Container/Container.astro';
import Navigation from './Navigation/Navigation.astro';
---

<header>
  <Container>
    <div class="content">
      <a
        aria-label="Go to homepage"         data-astro-prefetch         href="/"
      >
        <Logo aria-hidden="true" />
      </a>
      <Navigation />
    </div>
  </Container>
</header>

<style>
  header {
    padding-block-start: 3rem;
    background-color: var(--header-background-color, transparent);
  }

  .content {
    display: grid;
    position: relative;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: 1.5rem 0;
  }

  a {
    --logo-color: var(--header-foreground-color);

    display: inline-block;
    inline-size: fit-content;

    &:is(:hover, :focus-visible) {
      --logo-color: light-dark(
        hsl(from var(--header-foreground-color) h s calc(l - 10)),
        hsl(from var(--header-foreground-color) h s calc(l + 10))
      );

      @media (prefers-reduced-motion: no-preference) {
        animation: boink 0.25s ease-in-out;
      }
    }
  }

  svg {
    display: block;
    block-size: 3rem;
    inline-size: 3rem;
    will-change: transform;
  }

  @keyframes boink {
    50% {
      transform: rotateZ(-5deg);
    }
  }
</style>
