---
interface Props {
  href?: string;
  elevation?: 'low' | 'high';
}

const { href, elevation } = Astro.props;

const elevationClass = elevation ? `elevation-${elevation}` : undefined;
---

{
  href ? (
    <a
      class:list={elevationClass}
      data-astro-prefetch
      href={href}
    >
      <slot />
    </a>
  ) : (
    <button class:list={elevationClass}>
      <slot />
    </button>
  )
}

<style>
  a,
  button {
    display: inline-flex;
    position: relative;
    align-items: center;
    padding: 0.75rem 1.5rem;
    border-radius: var(--border-radius);
    background-color: var(--button-background-color);
    color: var(--button-text-color);
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    gap: 0.5rem;
    appearance: none;

    &:is(:hover, :focus-visible) {
      background-color: light-dark(
        hsl(from var(--button-background-color) h s calc(l - 10)),
        hsl(from var(--button-background-color) h s calc(l + 5))
      );
      color: var(--button-text-color);
      text-decoration: none;
    }

    @media (prefers-reduced-motion: no-preference) {
      transition: background-color 0.25s ease-in-out;
    }

    @container teaser (inline-size <= 30rem) {
      display: flex;
      inline-size: fit-content;
      text-align: start;
    }
  }
</style>
