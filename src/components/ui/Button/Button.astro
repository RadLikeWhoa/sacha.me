---
import Icon from '../Icon/Icon.astro';

interface Props {
  href?: string;
  raised?: boolean;
  prefix?: string;
  suffix?: string;
}

const { href, raised, prefix, suffix } = Astro.props;
---

{
  href ? (
    <a
      href={href}
      class:list={[{ raised }]}
      data-astro-prefetch
    >
      {prefix && <Icon>{prefix}</Icon>}
      <slot />
      {suffix && <Icon>{suffix}</Icon>}
    </a>
  ) : (
    <button class:list={[{ raised }]}>
      {prefix && <Icon>{prefix}</Icon>}
      <slot />
      {suffix && <Icon>{suffix}</Icon>}
    </button>
  )
}

<style>
  a,
  button {
    display: inline-flex;
    position: relative;
    align-items: center;
    padding: 0.75rem 1.5rem;
    border-radius: 10px;
    background-color: var(--accent-color);
    color: #fdf9f2;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    gap: 0.5rem;
    appearance: none;

    &:is(:hover, :focus-visible) {
      text-decoration: none;
    }
  }

  .raised {
    box-shadow: var(--shadow-elevation-high);
  }
</style>
