---
import { SITE_METADATA } from '@/consts';
import { generateJsonLd } from '@/utils/json-ld';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article' | 'project';
  pubDate?: Date;
  updatedDate?: Date;
  noindex?: boolean;
}

const {
  title,
  description,
  type = 'website',
  pubDate,
  updatedDate,
  noindex,
} = Astro.props;

const resolvedTitle = title
  ? `${title} — ${SITE_METADATA.title}`
  : SITE_METADATA.title;

const resolvedDescription = description || SITE_METADATA.description;

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || SITE_METADATA.url,
);

const jsonLdString = generateJsonLd({
  type,
  title: title || SITE_METADATA.title,
  description: resolvedDescription,
  url: canonicalURL.toString(),
  pubDate,
  updatedDate,
});
---

<title>{resolvedTitle}</title>
{
  noindex && (
    <meta
      content="noindex, nofollow"       name="robots"
    />
  )
}
<meta
  content={resolvedDescription}   name="description"
/>
<link
  href={canonicalURL}   rel="canonical"
/>
<meta
  content={type === 'article' ? 'article' : 'website'}   property="og:type"
/>
<meta
  content={canonicalURL}   property="og:url"
/>
<meta
  content={resolvedTitle}   property="og:title"
/>
<meta
  content={resolvedDescription}   property="og:description"
/>
<meta
  content="summary"   name="twitter:card"
/>
<meta
  content={canonicalURL}   name="twitter:url"
/>
<meta
  content={resolvedTitle}   name="twitter:title"
/>
<meta
  content={resolvedDescription}   name="twitter:description"
/>
<script
  is:inline   set:html={jsonLdString}   type="application/ld+json"
/>
