---
import type { CollectionEntry } from 'astro:content';

interface Props {
  article: CollectionEntry<'articles'>;
  level?: 'h2' | 'h3';
}

const { article, level: Heading = 'h2' } = Astro.props;

const {
  id,
  data: { title, teaser },
} = article;
---

<article>
  <Heading>
    <a
      href={`/articles/${id}`}
      data-astro-prefetch
    >
      {title}
    </a>
  </Heading>
  <p>{teaser}</p>
</article>

<style>
  article {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
