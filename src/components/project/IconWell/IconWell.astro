---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  elevation?: 'low' | 'high';
}

const { project, elevation } = Astro.props;

const {
  id,
  data: { title, accent, icon },
} = project;
---

<a href={`/projects/${id}`}>
  <div class:list={['icon-well', elevation]}>
    <Image
      src={icon}
      alt={`${title} icon`}
    />
  </div>
</a>

<style define:vars={{ accent }}>
  a {
    display: block;
  }

  .icon-well {
    display: grid;
    border-radius: 10px;
    place-content: center;
    background-color: var(--accent);
  }

  .low {
    box-shadow: var(--shadow-elevation-low);
  }

  .high {
    box-shadow: var(--shadow-elevation-high);
  }

  img {
    display: block;
    position: relative;
    z-index: 1;
    max-block-size: 100%;
    max-inline-size: 100%;
  }
</style>
