---
import type { CollectionEntry } from 'astro:content';
import IconWell from '../IconWell/IconWell.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  alternate: boolean;
}

const { project, alternate } = Astro.props;

const {
  id,
  data: { title, teaser, date, accent },
} = project;
---

<article class:list={[{ alternate }]}>
  <IconWell
    project={project}
    elevation="low"
  />
  <div class="content">
    <h1>
      <a
        href={`/projects/${id}`}
        data-astro-prefetch
      >
        {title}
      </a>
    </h1>
    <p>
      <time>{date.toLocaleDateString('en-UK', { year: 'numeric' })}</time> – {
        teaser
      }
    </p>
  </div>
</article>

<style define:vars={{ 'accent-color': accent }}>
  article {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;

    @container content-list (min-inline-size: 30rem) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);

      .icon-well {
        rotate: -1deg;
      }

      &.alternate {
        grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);

        .icon-well {
          rotate: 1deg;
        }
      }
    }
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 1rem;

    @container content-list (min-inline-size: 30rem) {
      .alternate & {
        order: -1;
      }
    }
  }

  a {
    color: var(--accent-color);
  }

  time {
    color: #aaa;
  }
</style>
