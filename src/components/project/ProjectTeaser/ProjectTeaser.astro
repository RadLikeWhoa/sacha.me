---
import type { CollectionEntry } from 'astro:content';
import IconWell from '../IconWell/IconWell.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  alternate: boolean;
}

const { project, alternate } = Astro.props;

const {
  id,
  data: { title, teaser, date },
} = project;
---

<article class:list={[{ alternate }]}>
  <IconWell
    project={project}
    elevation="low"
  />
  <div class="content">
    <h1>
      <a
        href={`/projects/${id}`}
        data-astro-prefetch
      >
        {title}
      </a>
    </h1>
    <p>
      <time>{date.toLocaleDateString('en-UK', { year: 'numeric' })}</time> – {
        teaser
      }
    </p>
  </div>
</article>

<style>
  article {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  time {
    color: #aaa;
  }
</style>
