---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  raised?: boolean;
}

const { href, variant = 'primary', raised } = Astro.props;
---

{
  href ? (
    <a
      href={href}
      class:list={[variant, { raised }]}
    >
      <slot />
    </a>
  ) : (
    <button class:list={[variant, { raised }]}>
      <slot />
    </button>
  )
}

<style>
  a,
  button {
    display: inline-flex;
    position: relative;
    padding: 0.75rem 1.5rem;
    border-radius: 5px 0;
    background-color: var(--color-brand);
    color: var(--color-white);
    font-weight: 700;
    cursor: pointer;
    appearance: none;

    &:hover,
    &:focus-visible {
      text-decoration: none;
    }
  }

  .secondary {
    background-color: #f6e5cb;
    color: #333;
  }

  .raised {
    box-shadow: 0 5px 10px rgb(51 51 51 / 35%);
  }
</style>
