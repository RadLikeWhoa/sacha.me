---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  raised?: boolean;
}

const { project, raised } = Astro.props;

const {
  id,
  data: { title, background, icon },
} = project;
---

<a href={`/projects/${id}`}>
  <div
    class:list={['icon-well', { raised }]}
    style={{ backgroundColor: background }}
  >
    <Image
      src={icon}
      alt={`${title} icon`}
    />
  </div>
</a>

<style>
  a {
    display: block;
  }

  .icon-well {
    display: grid;
    border-radius: 10px;
    place-content: center;

    &.raised {
      box-shadow: 0 5px 10px rgb(51 51 51 / 35%);
    }
  }

  img {
    display: block;
    position: relative;
    z-index: 1;
    max-block-size: 100%;
    max-inline-size: 100%;
  }
</style>
