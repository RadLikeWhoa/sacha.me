---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  path: string;
  title: string;
  background: string;
  icon: ImageMetadata;
}

const { path, title, background, icon } = Astro.props;
---

<a
  href={path}
  class="link"
>
  <div
    class="icon-well"
    style={{ backgroundColor: background }}
  >
    <Image
      src={icon}
      class="icon"
      alt={`${title} icon`}
    />
  </div>
</a>

<style>
  .link {
    display: block;
  }

  .icon-well {
    display: grid;
    place-content: center;
    border-radius: 10px;
    box-shadow: 0 5px 10px rgb(51 51 51 / 0.35);
  }

  .icon {
    display: block;
    max-block-size: 100%;
    max-inline-size: 100%;
  }
</style>
