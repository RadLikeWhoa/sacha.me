---
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import { Font } from 'astro:assets';

interface Props {
  title?: string;
  accent?: string;
  headerBackgroundColor?: string;
  headerForegroundColor?: string;
}

const {
  title,
  accent = '#009f4d',
  headerBackgroundColor,
  headerForegroundColor,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
    <link
      rel="icon"
      href="/favicon.ico"
    />
    <Font cssVariable="--font-material-symbols" />
    <title>{title ? `${title} — Sacha Schmid` : 'Sacha Schmid'}</title>
    <style
      is:global
      define:vars={{
        accent,
        'header-background-color': headerBackgroundColor,
        'header-foreground-color': headerForegroundColor,
      }}
    >
      :root {
        --accent-color: var(--accent);

        --header-foreground-color: var(--header-foreground-color);
        --header-background-color: var(--header-background-color);

        --content-width: 75ch;

        --shadow-color: #ae997a;

        --shadow-elevation-low:
          0px 0.6px 0.7px rgb(from var(--shadow-color) r g b / 34%),
          0px 1px 1.1px -1.2px rgb(from var(--shadow-color) r g b / 34%),
          0px 2.5px 2.8px -2.5px rgb(from var(--shadow-color) r g b / 34%);

        --shadow-elevation-high:
          0px 0.6px 0.7px rgb(from var(--shadow-color) r g b / 34%),
          0px 2px 2.3px -0.8px rgb(from var(--shadow-color) r g b / 34%),
          0px 5px 5.6px -1.7px rgb(from var(--shadow-color) r g b / 34%),
          0px 12.3px 13.8px -2.5px rgb(from var(--shadow-color) r g b / 34%);
      }

      * {
        box-sizing: border-box;
      }

      html {
        font:
          100%/1.5 Avenir Next,
          Avenir,
          Helvetica Neue,
          Arial,
          sans-serif;

        @media (min-width: 30rem) {
          font-size: 112.5%;
        }

        @media (min-width: 45rem) {
          font-size: 125%;
        }
      }

      body {
        margin: 0;
        background-color: #faf0e1;
        color: #333;
      }

      :is(h1, h2, h3, p, ul, ol, dl, pre) {
        margin-block: 0;
      }

      a {
        color: var(--accent-color);
      }

      dl {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
        padding: 0;
        border-radius: 10px;
        background-color: #fdf9f2;
        box-shadow: var(--shadow-elevation-low);
      }

      :is(dt, dd):not(:nth-last-child(-n + 2)) {
        border-block-end: 1px solid #f5e1c2;
      }

      dt {
        padding: 0.25rem 0.75rem;
        color: #aaa;
        border-inline-end: 1px solid #f5e1c2;
      }

      dd {
        margin: 0;
        padding: 0.25rem 0.75rem;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
