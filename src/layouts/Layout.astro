---
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import { Font } from 'astro:assets';

interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
    <link
      rel="icon"
      href="/favicon.ico"
    />
    <title>{title ? `${title} - Sacha Schmid` : 'Sacha Schmid'}</title>
    <Font
      cssVariable="--font-lato"
      preload
    />
    <style is:global>
      :root {
        --color-brand: #e95e7a;
        --color-white: #faf0e1;
      }

      * {
        box-sizing: border-box;
      }

      html {
        font:
          100%/1.5 Avenir Next,
          Avenir,
          Helvetica Neue,
          Arial,
          sans-serif;

        @media (min-width: 30rem) {
          font-size: 112.5%;
        }

        @media (min-width: 45rem) {
          font-size: 125%;
        }
      }

      body {
        margin: 0;
        background-color: var(--color-white);
        color: #333;
      }

      h1,
      h2,
      h3,
      p {
        margin-block-start: 0;
      }

      a {
        color: var(--color-brand);
        text-decoration: none;

        &:hover,
        &:focus-visible {
          text-decoration: underline;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
