---
import SEO from '@/components/seo/SEO/SEO.astro';
import Footer from '@/components/ui/Footer/Footer.astro';
import Header from '@/components/ui/Header/Header.astro';
import type { ComponentProps } from 'astro/types';
import { SITE_METADATA } from '../consts';

interface Props {
  accent?: string;
  headerBackgroundColor?: string;
  headerForegroundColor?: string;
  seo?: ComponentProps<typeof SEO>;
}

const { accent, headerBackgroundColor, headerForegroundColor, seo } =
  Astro.props;

const cssProperties: Record<string, string> = {};

if (accent) {
  cssProperties['--accent-color'] = accent;
}

if (headerBackgroundColor) {
  cssProperties['--header-background-color'] = headerBackgroundColor;
}

if (headerForegroundColor) {
  cssProperties['--header-foreground-color'] = headerForegroundColor;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      content="width=device-width, initial-scale=1"
      name="viewport"
    />
    <meta
      content="#009f4d"
      media="(prefers-color-scheme: light)"
      name="theme-color"
    />
    <meta
      content="#00e670"
      media="(prefers-color-scheme: dark)"
      name="theme-color"
    />
    <link
      href="/favicon.ico"
      rel="icon"
      sizes="32x32"
    />
    <link
      href="/favicon.svg"
      rel="icon"
      type="image/svg+xml"
    />
    <link
      href="/apple-touch-icon.png"
      rel="apple-touch-icon"
    />
    <link
      href="/rss.xml"
      rel="alternate"
      title={SITE_METADATA.title}
      type="application/rss+xml"
    />
    <SEO {...seo} />
    <style is:global>
      :root {
        --border-radius: 10px;

        --max-content-width: 80ch;

        --accent-color: light-dark(#00803e, #00e670);
        --background-color: light-dark(#fbf2e5, #161514);
        --header-background-color: var(--background-color);
        --header-foreground-color: var(--accent-color);
        --link-color: var(--accent-color);
        --text-color: light-dark(#333333, #eaeaea);
        --text-color-muted: light-dark(#6e6e6e, #bababa);
        --button-background-color: var(--accent-color);
        --button-text-color: light-dark(#ffffff, #161514);
        --widget-color: hsl(from var(--background-color) h s calc(l + 5));

        --shadow-color: light-dark(
          hsl(from var(--background-color) h calc(s - 45) calc(l - 35)),
          hsl(from var(--background-color) h calc(s + 10) calc(l + 15))
        );

        --shadow-elevation-low:
          0px 0.6px 0.7px rgb(from var(--shadow-color) r g b / 34%),
          0px 1px 1.1px -1.2px rgb(from var(--shadow-color) r g b / 34%),
          0px 2.5px 2.8px -2.5px rgb(from var(--shadow-color) r g b / 34%);

        --shadow-elevation-high:
          0px 0.6px 0.7px rgb(from var(--shadow-color) r g b / 34%),
          0px 2px 2.3px -0.8px rgb(from var(--shadow-color) r g b / 34%),
          0px 5px 5.6px -1.7px rgb(from var(--shadow-color) r g b / 34%),
          0px 12.3px 13.8px -2.5px rgb(from var(--shadow-color) r g b / 34%);

        color-scheme: light dark;
      }

      * {
        box-sizing: border-box;
      }

      html {
        font:
          100%/1.5 Avenir Next,
          Avenir,
          Helvetica Neue,
          Arial,
          sans-serif;

        @media (min-width: 30rem) {
          font-size: 112.5%;
        }

        @media (min-width: 45rem) {
          font-size: 125%;
        }

        @media (min-width: 60rem) {
          font-size: 137.5%;
        }
      }

      body {
        margin: 0;
        background-color: var(--background-color);
        color: var(--text-color);
      }

      :is(h1, h2, h3, p, ul, ol, dl, pre) {
        margin-block: 0;
      }

      h1 {
        font-size: 2.027rem;
      }

      h2 {
        font-size: 1.802rem;
      }
      h3 {
        font-size: 1.602rem;
      }

      h4 {
        font-size: 1.424rem;
      }

      h5 {
        font-size: 1.266rem;
      }

      h6 {
        font-size: 1.125rem;
      }

      a {
        color: var(--accent-color);
        text-decoration-color: transparent;

        &:is(:hover, :focus-visible) {
          color: light-dark(
            hsl(from var(--accent-color) h s calc(l - 10)),
            hsl(from var(--accent-color) h s calc(l + 10))
          );
          text-decoration-color: currentColor;
        }

        @media (prefers-reduced-motion: no-preference) {
          transition:
            color 0.25s ease-in-out,
            text-decoration-color 0.25s ease-in-out;
        }
      }

      dl {
        padding: 0.5rem 1rem;
        border-radius: var(--border-radius);
        background-color: var(--widget-color);
        box-shadow: var(--shadow-elevation-low);
      }

      dt {
        color: var(--text-color-muted);

        dd + & {
          margin-block-start: 0.5rem;
          padding-block-start: 0.5rem;
          border-block-start: 1px solid
            hsl(from var(--background-color) h calc(s - 20) calc(l - 10));
        }
      }

      dd {
        margin: 0;
      }

      .elevation-low {
        box-shadow: var(--shadow-elevation-low);
      }

      .elevation-high {
        box-shadow: var(--shadow-elevation-high);
      }

      .visually-hidden {
        position: absolute;
        block-size: 1px;
        inline-size: 1px;
        overflow: hidden;
        white-space: nowrap;
        clip-path: inset(50%);
      }

      .container {
        max-inline-size: min(var(--max-content-width), 100dvw - 3rem);
        margin-inline: auto;
      }

      main {
        container: main / inline-size;
      }
    </style>
  </head>
  <body style={cssProperties}>
    <Header />
    <main class="container">
      <slot />
    </main>
    <Footer />
  </body>
</html>
