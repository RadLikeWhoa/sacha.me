---
import SEO from '@/components/seo/SEO/SEO.astro';
import Footer from '@/components/ui/Footer/Footer.astro';
import Header from '@/components/ui/Header/Header.astro';
import type { ComponentProps } from 'astro/types';
import { Font } from 'astro:assets';
import { SITE_METADATA } from '../consts';

interface Props {
  accent?: string;
  headerBackgroundColor?: string;
  headerForegroundColor?: string;
  seo?: ComponentProps<typeof SEO>;
}

const {
  accent = '#009f4d',
  headerBackgroundColor = '#faf0e1',
  headerForegroundColor = '#009f4d',
  seo,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <meta
      name="robots"
      content="index, follow"
    />
    <meta
      name="theme-color"
      content="#009f4d"
    />
    <link
      rel="icon"
      href="/favicon.ico"
      sizes="32x32"
    />
    <link
      rel="icon"
      href="/favicon.svg"
      type="image/svg+xml"
    />
    <link
      rel="apple-touch-icon"
      href="/apple-touch-icon.png"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_METADATA.title}
      href="/rss.xml"
    />
    <Font cssVariable="--font-material-symbols" />
    <SEO {...seo} />
    <style
      is:global
      define:vars={{
        'accent-color': accent,
      }}
    >
      :root {
        --border-radius: 10px;

        --shadow-color: #ae997a;

        --shadow-elevation-low:
          0px 0.6px 0.7px rgb(from var(--shadow-color) r g b / 34%),
          0px 1px 1.1px -1.2px rgb(from var(--shadow-color) r g b / 34%),
          0px 2.5px 2.8px -2.5px rgb(from var(--shadow-color) r g b / 34%);

        --shadow-elevation-high:
          0px 0.6px 0.7px rgb(from var(--shadow-color) r g b / 34%),
          0px 2px 2.3px -0.8px rgb(from var(--shadow-color) r g b / 34%),
          0px 5px 5.6px -1.7px rgb(from var(--shadow-color) r g b / 34%),
          0px 12.3px 13.8px -2.5px rgb(from var(--shadow-color) r g b / 34%);
      }

      * {
        box-sizing: border-box;
      }

      html {
        font:
          100%/1.5 Avenir Next,
          Avenir,
          Helvetica Neue,
          Arial,
          sans-serif;

        @media (min-width: 30rem) {
          font-size: 112.5%;
        }

        @media (min-width: 45rem) {
          font-size: 125%;
        }

        @media (min-width: 60rem) {
          font-size: 137.5%;
        }
      }

      body {
        margin: 0;
        background-color: #faf0e1;
        color: #333;
      }

      :is(h1, h2, h3, p, ul, ol, dl, pre) {
        margin-block: 0;
      }

      a {
        transition:
          color 0.25s ease-in-out,
          text-decoration-color 0.25s ease-in-out;
        color: var(--accent-color);
        text-decoration-color: transparent;

        &:is(:hover, :focus-visible) {
          color: hsl(from var(--accent-color) h s calc(l - 10));
          text-decoration-color: currentColor;
        }
      }

      dl {
        padding: 0.5rem 1rem;
        border-radius: var(--border-radius);
        background-color: #fdf9f2;
        box-shadow: var(--shadow-elevation-low);
      }

      dt {
        color: #aaa;

        dd + & {
          margin-block-start: 0.5rem;
          padding-block-start: 0.5rem;
          border-block-start: 1px solid #eadfcd;
        }
      }

      dd {
        margin: 0;
      }
    </style>
  </head>
  <body
    style={{
      '--header-background-color': headerBackgroundColor,
      '--header-foreground-color': headerForegroundColor,
    }}
  >
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
