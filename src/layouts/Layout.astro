---
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import { Font } from 'astro:assets';

interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
    <link
      rel="icon"
      href="/favicon.ico"
    />
    <Font cssVariable="--font-material-symbols" />
    <title>{title ? `${title} — Sacha Schmid` : 'Sacha Schmid'}</title>
    <style is:global>
      :root {
        --color-brand: #009f4d;
        --color-white: #faf0e1;
        --content-width: 75ch;
      }

      * {
        box-sizing: border-box;
      }

      html {
        font:
          100%/1.5 Avenir Next,
          Avenir,
          Helvetica Neue,
          Arial,
          sans-serif;

        @media (min-width: 30rem) {
          font-size: 112.5%;
        }

        @media (min-width: 45rem) {
          font-size: 125%;
        }
      }

      body {
        margin: 0;
        background-color: var(--color-white);
        color: #333;
      }

      :is(h1, h2, h3, p, ul, ol, dl, pre) {
        margin-block-start: 0;
      }

      :is(p, ul, ol, dl, pre) {
        margin-block-end: 1.5rem;
      }

      a {
        color: var(--color-brand);
      }

      dl {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
        padding: 0;
        border: 1px solid #e4e0d9;
        border-radius: 10px;
        background-color: #f6e5cb;
      }

      :is(dt, dd):not(:nth-last-child(-n + 2)) {
        border-block-end: 1px solid #e4e0d9;
      }

      dt {
        padding: 0.25rem 0.75rem;
        color: #aaa;
        border-inline-end: 1px solid #e4e0d9;
      }

      dd {
        margin: 0;
        padding: 0.25rem 0.75rem;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
